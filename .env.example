# Web Voice Copilot - Environment Configuration Template
# Copy this file to .env and populate with your own API credentials.

# ==============================================================================
# Server Settings
# ==============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# ==============================================================================
# Speech-to-Text (STT) Providers
# ==============================================================================
# Deepgram is recommended for fastest real-time streaming transcription (~150ms)
# Obtain an API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ==============================================================================
# LLM Providers (Google Gemini, OpenAI, or Groq)
# ==============================================================================
# 1. Google Gemini (Recommended - sub-200ms latency, 1,500 free requests/day):
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_MODEL_NAME=gemini-3.5-flash-lite

# 2. OpenAI or Groq (Alternative):
# OPENAI_API_KEY=your_openai_or_groq_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Text-to-Speech (TTS) Providers
# ==============================================================================
# Options: eleven_labs (Default studio quality), cartesia, edge_tts, stream_elements, azure
TTS_PROVIDER=eleven_labs

# ElevenLabs Settings (Streaming Turbo v2.5 in Linear16 PCM 16kHz)
# Obtain an API key from: https://elevenlabs.io/
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key_here
ELEVEN_LABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVEN_LABS_MODEL_ID=eleven_turbo_v2_5

# Edge-TTS Settings (Free fallback)
EDGE_TTS_VOICE=en-US-AriaNeural

# Optional Providers
CARTESIA_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
STREAMELEMENTS_API_KEY=
STREAMELEMENTS_VOICE=Brian

# ==============================================================================
# Default Agent Persona
# ==============================================================================
# Built-in options: concierge, receptionist, tech_screener, school_receptionist
DEFAULT_PERSONA=concierge
