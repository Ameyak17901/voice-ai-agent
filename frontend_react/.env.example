# Frontend Environment Variables (Vercel)
# In production on Vercel, set these in Project Settings -> Environment Variables.

# Render Backend REST API Base URL (HTTPS)
VITE_API_URL=https://your-backend.onrender.com

# Render Backend WebSocket URL (WSS)
# Optional: if omitted, VITE_API_URL will be used with wss:// scheme automatically.
VITE_WS_URL=wss://your-backend.onrender.com
